    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-scheduler": "^3.1141.0",
    "@aws-sdk/client-secrets-manager": "^3.1140.0",
    "@aws-sdk/client-sqs": "^3.1140.0",
