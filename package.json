{
  "name": "whatsapp-smartthings-service",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.8",
    "@anthropic-ai/sdk": "^0.128.0",
